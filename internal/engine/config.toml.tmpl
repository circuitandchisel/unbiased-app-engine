# Generated by unbiased-app-engine — do not edit; rewritten on every start.
#
# This engine home exists so the app-server is Pareto-only BY CONSTRUCTION:
# it is regenerated from this template at startup and never reads ~/.codex,
# so no leftover user config can point the engine anywhere but the Unbiased
# gateway, and no client can accidentally reach OpenAI directly.
model = "pareto"
model_provider = "unbiased"
model_reasoning_effort = "none"
web_search = "disabled"

# Pareto is not in codex's model catalog, so codex falls back to generic
# metadata: a 272k window and, critically, NO auto-compaction limit. Both
# halves are wrong for us — tier-1 actually serves 131,072, and with no limit
# nothing ever compacts, so history grows until the gateway refuses it.
#
# Setting the window explicitly arms two separate mechanisms:
#
#  1. Proactive: pre-turn compaction fires at the limit below, before a
#     request can outgrow the backend.
#  2. Reactive: when the gateway reports an overflow, codex calls
#     set_total_tokens_full (session/mod.rs) — which is a NO-OP when
#     model_context_window is unset. Without this line an overflow cannot
#     self-heal: usage is never marked full, so the next turn does not
#     compact and the thread repeats the same failure forever.
#
# The proactive half carries the weight, because codex does NOT compact
# mid-turn: on ContextWindowExceeded it marks tokens full and fails the turn
# (session/turn.rs). Recovery happens on the NEXT turn, so hitting the wall
# always costs one turn. The reactive path is the safety net for when this
# window is wrong, not the primary plan.
#
# 128k matches what the rest of the ecosystem declares for Pareto
# (unbiased-cli's pi provider block, from the integration guide). Compaction
# arms at ~75% so the summarization request itself, plus the turn that
# follows, still fit.
#
# Note on history: an earlier version of this comment claimed a conversation
# reached ~419k input tokens and died. That was a misreading of
# total_token_usage (CUMULATIVE session usage) as live context — the thread's
# live context was 26,892. Those failures were a gateway-side stream sever,
# fixed separately in gpu-router#433. The settings below are still right, for
# the reasons above rather than that anecdote.
model_context_window = 128000
model_auto_compact_token_limit = 96000

[model_providers.unbiased]
name = "Unbiased"
base_url = "{{BASE_URL}}"
wire_api = "responses"
env_key = "UNBIASED_API_KEY"

[features]
# v1 (plain-tool) collab stays off — multi-agent ships as v2 below.
multi_agent = false

# Multi-agent v2: the engine spawns sub-agents in-process; their collaboration
# tools ride a Responses-API namespace, flattened to `collaboration__*`
# functions and split back by the gateway (gpu-router#414, live). Sub-agents
# inherit this provider config, so Pareto-only-by-construction extends to
# every spawn.
[features.multi_agent_v2]
enabled = true
# Root + sub-agents per session. Every concurrent agent multiplies gateway
# spend per user action — raise deliberately, not casually.
max_concurrent_threads_per_session = 5
# Keep model/reasoning overrides OFF the spawn tool schema: sub-agents always
# inherit "pareto", and advertising choices would invite the model to request
# deployments the gateway doesn't serve.
expose_spawn_agent_model_overrides = false
# Include the engine-assigned nickname in spawn outputs — the desktop app
# titles each sub-agent with it (Codex-style names like "Ramanujan").
hide_spawn_agent_metadata = false
