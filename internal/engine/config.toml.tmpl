# Generated by unbiased-app-engine — do not edit; rewritten on every start.
#
# This engine home exists so the app-server is Pareto-only BY CONSTRUCTION:
# it is regenerated from this template at startup and never reads ~/.codex,
# so no leftover user config can point the engine anywhere but the Unbiased
# gateway, and no client can accidentally reach OpenAI directly.
model = "pareto-26.10-preview"
model_provider = "unbiased"
model_reasoning_effort = "none"
web_search = "disabled"

# The loopback port codex listens on while an MCP OAuth sign-in is in flight.
#
# Pinned, not left to pick a free port, because the redirect URI has to be
# PREDICTABLE. The app registers our own OAuth client with a provider before
# handing codex its client_id — that registration must declare the exact
# redirect URI codex will later use, and an ephemeral port makes that
# impossible. With the port fixed the whole URI is computable:
#
#   http://127.0.0.1:45999/callback/<base64url(sha256(server_url)[:9])>
#
# The path half was measured, not guessed: the same server URL under two
# different server names produced a byte-identical path, and the derivation
# above reproduced it exactly for two unrelated URLs.
#
# Why this matters: without a client_id of our own, codex registers itself
# dynamically and sends a hardcoded client_name of "Codex", so the provider's
# consent screen reads "Codex is requesting access" inside a product that is
# not Codex. That name is not configurable anywhere in the binary.
mcp_oauth_callback_port = 45999

# Pareto preview is not in codex's model catalog, so codex falls back to generic
# metadata and, critically, NO auto-compaction limit. Both halves are wrong for
# us: pareto-26.10-preview serves a 1,048,576-token context window, and with no
# limit nothing ever compacts, so history grows until the gateway refuses it.
#
# Setting the window explicitly arms two separate mechanisms:
#
#  1. Proactive: pre-turn compaction fires at the limit below, before a
#     request can outgrow the backend.
#  2. Reactive: when the gateway reports an overflow, codex calls
#     set_total_tokens_full (session/mod.rs) — which is a NO-OP when
#     model_context_window is unset. Without this line an overflow cannot
#     self-heal: usage is never marked full, so the next turn does not
#     compact and the thread repeats the same failure forever.
#
# The proactive half carries the weight, because codex does NOT compact
# mid-turn: on ContextWindowExceeded it marks tokens full and fails the turn
# (session/turn.rs). Recovery happens on the NEXT turn, so hitting the wall
# always costs one turn. The reactive path is the safety net for when this
# window is wrong, not the primary plan.
#
# The value is the live gateway limit for pareto-26.10-preview. A direct
# Responses API probe accepted 1,000,013 input tokens plus a 1-token completion,
# and rejected a 1,050,013-token prompt with context_length_exceeded:
# "maximum context length is 1048576 tokens including the completion."
#
# Do NOT round this down for safety. Codex already applies its own margin:
# effective_context_window_percent (95, not settable from config — Pareto is
# absent from codex's model catalog, so we inherit the default) means the
# session reports 1048576 * 0.95 = 996,147. Keep the configured window exact
# and put the operational margin in model_auto_compact_token_limit instead.
#
# Compaction arms at 75% of the full window so the summarization request itself,
# plus the turn that follows, still fit comfortably under the usable 95% window.
# Letting codex default to 90% would leave only ~52k usable tokens of headroom
# for the compaction request on this million-token model.
model_context_window = 1048576
model_auto_compact_token_limit = 786432

[model_providers.unbiased]
name = "Unbiased"
base_url = "{{BASE_URL}}"
wire_api = "responses"
env_key = "UNBIASED_API_KEY"

[features]
# v1 (plain-tool) collab stays off — multi-agent ships as v2 below.
multi_agent = false

# Multi-agent v2: the engine spawns sub-agents in-process; their collaboration
# tools ride a Responses-API namespace, flattened to `collaboration__*`
# functions and split back by the gateway's namespace adapter. Sub-agents
# inherit this provider config, so Pareto-only-by-construction extends to
# every spawn.
[features.multi_agent_v2]
enabled = true
# Root + sub-agents per session. Every concurrent agent multiplies gateway
# spend per user action — raise deliberately, not casually.
max_concurrent_threads_per_session = 5
# Keep model/reasoning overrides OFF the spawn tool schema: sub-agents always
# inherit "pareto", and advertising choices would invite the model to request
# deployments the gateway doesn't serve.
expose_spawn_agent_model_overrides = false
# Include the engine-assigned nickname in spawn outputs — the desktop app
# titles each sub-agent with it (Codex-style names like "Ramanujan").
hide_spawn_agent_metadata = false

# MCP servers, rendered from engine.BuiltinMCPServers() — empty by default, in
# which case no [mcp_servers.*] table is written and the engine behaves exactly
# as it did before this section existed.
#
# codex has always supported these; the gateway is what changed. An MCP
# server's tools arrive as a `namespace` group, which chat-completions cannot
# express, so the gateway flattens each to `<namespace>__<tool>` upstream
# and splits it back on the way out — the same path multi-agent v2 above has
# used in production since 2026-08. That is why this is a config change and
# not a protocol project.
#
# Two things worth knowing before adding a server:
#
#  1. A stdio server does NOT inherit the engine's environment. Measured
#     against the pinned 0.147 binary on 2026-08-24: codex builds a child
#     environment of HOME, LOGNAME, PATH, SHELL, TMPDIR, USER and
#     __CF_USER_TEXT_ENCODING, plus whatever this file's `env` sets — nine
#     variables total. UNBIASED_API_KEY is stripped, and an unrelated variable
#     planted in the engine's own environment did not reach the child. So the
#     `env` table below is the ONLY channel for giving a server a variable,
#     which is also why engine.validate() refuses to let it set
#     UNBIASED_API_KEY: that would put back a credential codex deliberately
#     takes away.
#  2. An MCP server can raise mcpServerElicitationRequest — a server-initiated
#     request asking the USER a question, and codex advertises support for it
#     to every server it connects to (observed in the handshake:
#     capabilities.elicitation = {form, url}). The desktop app declines every
#     server request it does not recognise ("declining unhandled server
#     request", src/main/index.ts), so an eliciting server gets a decline
#     instead of an answer. Safe, but not useful: wire the app side before
#     shipping a server that depends on it.
{{MCP_SERVERS}}
